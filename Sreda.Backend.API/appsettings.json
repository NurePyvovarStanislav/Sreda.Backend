{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sreda": "Host=localhost;Port=5432;Database=SredaBD;Username=postgres;Password=123"
  },
  "Voice": {
    "Provider": "Real"
  },
  "CommandResolver": {
    "MinConfidence": 0.6
  },
  "Whisper": {
    "ExecutablePath": "C:\\tools\\whisper\\Release\\whisper-cli.exe",
    "ModelPath": "C:\\tools\\whisper\\models\\ggml-small.bin",
    "Language": "auto",
    "AdditionalArguments": "",
    "TimeoutSeconds": 120
  },
  "Piper": {
    "ExecutablePath": "C:\\tools\\piper-venv\\Scripts\\piper.exe",
    "DefaultLanguage": "en",
    "Voices": {
      "en": "C:\\tools\\piper\\models\\en\\en_US\\hfc_female\\medium\\en_US-hfc_female-medium.onnx",
      "ru": "C:\\tools\\piper\\models\\ru\\ru_RU\\irina\\medium\\ru_RU-irina-medium.onnx"
    },
    "AdditionalArguments": "",
    "TimeoutSeconds": 60
  },
  "Ffmpeg": {
    "ExecutablePath": "C:\\tools\\ffmpeg\\ffmpeg-master-latest-win64-gpl\\bin\\ffmpeg.exe",
    "TimeoutSeconds": 60
  },
  "Mqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "Username": null,
    "Password": null,
    "ClientId": "sreda-backend",
    "TopicPrefix": "sreda/devices",
    "ReconnectDelaySeconds": 5,
    "HeartbeatTimeoutSeconds": 60,
    "OfflineCheckIntervalSeconds": 30
  }
}
